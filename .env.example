# Copy to .env and adjust. Never commit .env.

# --- Core ---
DATABASE_URL=sqlite:///data/porchpiracy.db
BACKEND_URL=http://localhost:8000
LOG_LEVEL=INFO

# --- Protection and threat thresholds ---
PROTECTION_TIMEOUT_MINUTES=360
LOITER_THRESHOLD_SECONDS=8
NEAR_PACKAGE_DISTANCE_PX=150
INCIDENT_COOLDOWN_SECONDS=30

# --- Vision pipeline ---
FRAME_STRIDE=2
DETECTION_CONF_THRESHOLD=0.45
PERSON_MODEL_PATH=models_weights/yolov8n.pt
PACKAGE_MODEL_PATH=models_weights/package.pt

# --- Ring integration: local | real ---
RING_MODE=local
RING_CLIENT_ID=
RING_CLIENT_SECRET=
RING_TOKEN=
RING_BASE_URL=

# --- Local LLM (explanations only) ---
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b
LLM_ENABLED=false

# --- Optional Telegram notifier ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Dashboard: true reads samples/mock_events.json instead of the API ---
USE_MOCK=false
